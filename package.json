    "lint:commit": "commitlint --from=HEAD~1",
    "lint:commit:last": "commitlint --last",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
