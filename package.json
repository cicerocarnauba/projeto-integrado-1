{
  "name": "projeto-integrado-1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de Gerenciamento de Acervo de Biblioteca Escolar - Creche Maria de Lourdes (Nextron + SQLite)",
  "main": "app/main.js",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--experimental-transform-types nextron --startup-delay 5000",
